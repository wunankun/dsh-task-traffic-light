{
  "name": "dsh-task-traffic-light",
  "version": "1.0.6",
  "description": "A small traffic light that floats at the edge of your macOS desktop: see whether each task is running, waiting for you, or already finished without switching back to DeepSeek Harness, then click a lit lamp to jump to that session.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "traffic-light",
    "macos",
    "menu-bar",
    "notifications"
  ],
  "homepage": "https://github.com/wunankun/dsh-task-traffic-light#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wunankun/dsh-task-traffic-light.git"
  },
  "bugs": {
    "url": "https://github.com/wunankun/dsh-task-traffic-light/issues"
  },
  "engines": {
    "dsh": ">=0.2.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README*.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  }
}
