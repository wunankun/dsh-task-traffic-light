<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TaskTrafficLight</AssemblyName>
    <RootNamespace>TaskTrafficLight</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>任务红绿灯</Product>
    <AssemblyTitle>任务红绿灯</AssemblyTitle>
    <Description>Traffic light for DeepSeek Harness sessions</Description>
    <!-- Lets the project build (and CI verify it) on macOS and Linux too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
